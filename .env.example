# Copia in .env.local (sviluppo) o nelle Environment Variables di Vercel (produzione).
# Non committare mai valori reali.

# --- Supabase (Project Settings > API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chiave pubblica (publishable / anon): può stare nel browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chiave segreta (secret / service_role): SOLO server, mai nel browser
SUPABASE_SECRET_KEY=

# --- App -------------------------------------------------------------------
# URL pubblico, usato nei link delle email (senza / finale)
NEXT_PUBLIC_SITE_URL=https://prenota.example.com
# Attività mostrata su "/" (facoltativo; senza, "/" mostra una pagina neutra)
DEFAULT_BUSINESS_SLUG=barberhood
# Dominio dell'agenzia (facoltativo). Con questo valore: dominio e www = landing,
# admin.<dominio> = dashboard, demo.<dominio> = demo-barbiere, <slug>.<dominio> = quell'attività.
ROOT_DOMAIN=agendafacile.it
# Firma dei link "sposta/annulla". Almeno 32 caratteri casuali: openssl rand -base64 48
# Se lo cambi, i link già inviati smettono di funzionare.
MANAGE_TOKEN_SECRET=
# Protegge /api/cron/notifications. openssl rand -hex 32
CRON_SECRET=

# --- Email (Resend) — facoltativo finché non configuri il dominio ----------
RESEND_API_KEY=
# Mittente su un dominio verificato in Resend
EMAIL_FROM="Barberhood <prenotazioni@example.com>"

# --- Anti-bot (Cloudflare Turnstile) — facoltativo -------------------------
# Senza chiave restano attivi honeypot, tempo minimo di compilazione e rate limit.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
